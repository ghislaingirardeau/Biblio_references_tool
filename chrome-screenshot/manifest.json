{
  "manifest_version": 3,
  "name": "Capture écran - Mon application",
  "version": "1.0.0",
  "description": "Capture une zone de la page web.",
  "permissions": ["activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capturer une zone"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}

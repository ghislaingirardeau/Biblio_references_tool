{
  "manifest_version": 3,
  "name": "Extension - Biblio Tool",
  "version": "1.0.0",
  "description": "Références à envoyer vers votre Biblio Tool.",
  "permissions": ["activeTab", "tabs", "scripting"],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "Biblio tool extension",
    "default_popup": "dist/popup/popup.html"
  },
  "commands": {
    "start-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Biblio tool extension de la page"
    },

    "send-selected-text": {
      "suggested_key": {
        "default": "Ctrl+Shift+Q"
      },
      "description": "Envoyer le texte sélectionné vers Biblio Tool"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "css": ["dist/style.css"]
    }
  ],
  "host_permissions": [
    "https://biblio-references-tool.onrender.com/*",
    "http://localhost:9000/*",
    "http://127.0.0.1:32145/*"
  ],
  "externally_connectable": {
    "matches": ["https://biblio-references-tool.onrender.com/*", "http://localhost:9000/*"]
  }
}
